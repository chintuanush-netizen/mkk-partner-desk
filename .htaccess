# Single-page app: send every unknown path under /partners/ to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /partners/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /partners/index.html [L]
</IfModule>

# Cache built assets for a year; always re-check the page itself
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
